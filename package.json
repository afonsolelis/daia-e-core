{
  "name": "@daia-e/core",
  "version": "0.2.0",
  "description": "DAIA-E — Desenvolvimento Assistido por Inteligência Artificial Orientado por Especificação. Orquestração de agentes com descrição arquitetural ISO/IEC/IEEE 42010 e gates executáveis por baseline.",
  "main": "kernel/index.js",
  "bin": {
    "daia": "bin/daia.js"
  },
