{
  "$id": "daia-e/driver",
  "title": "Business Driver (BABOK — SP1)",
  "description": "A business driver. It tells why the system must exist and for whom.",
  "type": "object",
  "required": ["id", "kind", "statement", "stakeholders", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "daia-e/common#/definitions/id", "idPrefix": "BD" },
    "kind": { "const": "BusinessDriver" },
    "statement": { "type": "string", "minLength": 10 },
    "rationale": { "type": "string" },
    "stakeholders": { "$ref": "daia-e/common#/definitions/idRefList", "minItems": 1 },
    "idef0_node": { "type": "string", "description": "A node of the IDEF0 decomposition, for example A-0, A1, A12" },
    "hypothesis": { "type": "string", "description": "The hypothesis that SP5 must confirm or refute" },
    "sprint": { "const": "SP1" },
    "status": { "$ref": "daia-e/common#/definitions/status" },
    "provenance": { "$ref": "daia-e/common#/definitions/provenance" }
  }
}
