    { "id": "qaw", "sprint": "SP2-SP3", "views": [], "bok": "Quality Attribute Workshop" },
    { "id": "arch", "sprint": "SP3", "views": ["information", "computational", "engineering", "technology"], "bok": "SEBoK + ISO 42010 + RM-ODP" },
    { "id": "atam", "sprint": "SP3-SP4", "views": [], "bok": "ATAM" },
    { "id": "spec", "sprint": "SP3", "views": ["computational"], "bok": "SWEBOK" },
    { "id": "test", "sprint": "SP3", "views": [], "bok": "SWEBOK - Testes" },
    { "id": "dev", "sprint": "SP4", "views": ["technology"], "bok": "SWEBOK - Construcao" },
    { "id": "audit", "sprint": "SP4", "views": [], "bok": "SWEBOK - Qualidade" },
    { "id": "val", "sprint": "SP5", "views": [], "bok": "SEBoK - V&V" },
    { "id": "rec", "sprint": "*", "views": [], "bok": "-" }
  ]
